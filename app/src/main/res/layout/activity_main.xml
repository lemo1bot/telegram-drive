<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= SETUP WIZARD ================= -->
    <ScrollView
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Drive"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Step 1 of 3" />

            <ProgressBar
                android:id="@+id/setupProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="99"
                android:progress="33" />

            <!-- STEP 1 : BOTFATHER -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 — Make your free bot (2 minutes)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Tap OPEN BOTFATHER below (Telegram opens).\n2. Send: /newbot  (use the copy button)\n3. Give it any name, and a username ending in 'bot'.\n4. BotFather sends you a long TOKEN. Copy the whole token and paste it here." />

                <Button
                    android:id="@+id/openBotFatherButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open @BotFather in Telegram" />

                <Button
                    android:id="@+id/copyNewbotButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Copy /newbot" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Paste your bot token here"
                    android:inputType="text"
                    android:minLines="2" />

                <Button
                    android:id="@+id/checkTokenButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Check my token" />

                <TextView
                    android:id="@+id/tokenStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="" />

                <Button
                    android:id="@+id/nextToStep2Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="Next →" />
            </LinearLayout>

            <!-- STEP 2 : PRIVATE GROUP -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 — Make your private storage group"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. In Telegram: New Group → name it 'My Private Drive' → create it (only you).\n2. Open the group → Add members → add YOUR BOT.\n3. Long-press the bot in the group → Promote → make it ADMIN.\n4. Send any message in the group, like: hi\n5. Come back here and tap FIND MY GROUP." />

                <Button
                    android:id="@+id/detectChatButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Find my group automatically" />

                <TextView
                    android:id="@+id/detectStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="" />

                <Button
                    android:id="@+id/manualChatToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="I know my Chat ID (manual)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualChatInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Chat ID, e.g. -1001234567890"
                    android:inputType="numberSigned"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/useManualChatButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Use this Chat ID" />
            </LinearLayout>

            <!-- STEP 3 : SUMMARY + CONNECT -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 3 — Connect"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/summaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Connect my Drive" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Help: What is a bot? A free helper account in Telegram that this app uses to save your files. Lost your token? Talk to @BotFather → /mybots → your bot → API Token. Username taken? Try another ending, e.g. mydrive123bot." />
        </LinearLayout>
    </ScrollView>

    <!-- ================= DRIVE ================= -->
    <LinearLayout
        android:id="@+id/driveContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/driveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Drive"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/driveSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/folderSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/newFolderButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Folder" />

                <Button
                    android:id="@+id/gridToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grid" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Search files and notes…"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/uploadButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⬆ Upload file" />

                <Button
                    android:id="@+id/noteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📝 New note" />
            </LinearLayout>

            <!-- Premium: $10 one-time, removes ALL ads forever.
                 Text is updated in code with the real price from Google Play. -->
            <Button
                android:id="@+id/premiumButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⭐ Go Premium — $10 forever (no ads)" />

            <Button
                android:id="@+id/proModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🚀 Pro Mode — big files up to 2 GB / 4 GB (Telegram account)" />

            <Button
                android:id="@+id/followXButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Follow on X — @Bank_of_eth" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="No files here yet.\nTap Upload to send your first file to your private Telegram group."
            android:textAlignment="center" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnect Telegram" />

        <!-- AdMob banner: bottom of the Drive screen ONLY (never on setup screens).
             Ad unit ID is set in code from AdsConfig.BANNER_ID; the value below is Google's test ID. -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-8301774269044238/2806003913" />
    </LinearLayout>
</LinearLayout>
